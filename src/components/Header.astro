---
import dragonLogo from '../images/letterp.png';

const base = import.meta.env.BASE_URL;
const link = (path='') => `${base}${path}`.replace(/\/+/g,'/');
---
<header class="header">
  <a class="skip" href="#content">Skip to content</a>
  <div class="shell top"><a class="brand" href={link()} aria-label="Phuc Pham home"><img src={dragonLogo.src} alt="Phuc Pham" width="48" height="48" /></a><div class="issue mono">BIOLOGICAL INTELLIGENCE</div></div>
  <div class="shell navwrap"><nav aria-label="Primary"><a href={link('blog/')}>Essays</a><a href={link('topics/computational-biology/')}>Computational Biology</a><a href={link('topics/other/')}>Other Topics</a><a href={link('about/')}>About</a></nav><div class="header-controls"><div class="reading-settings" role="group" aria-label="Article text size"><span class="reading-mark" aria-hidden="true">Aa</span><button type="button" data-text-size="small" aria-label="Smaller article text" aria-pressed="false">A−</button><button type="button" data-text-size="medium" aria-label="Default article text size" aria-pressed="true">A</button><button type="button" data-text-size="large" aria-label="Larger article text" aria-pressed="false">A+</button></div><button id="theme" type="button" aria-label="Switch to light mode" aria-pressed="false"><span aria-hidden="true">☼</span><span class="theme-label">Light mode</span></button></div></div>
</header>
<script>
  type Theme='light'|'dark';
  type TextSize='small'|'medium'|'large';

  const applyTheme=(theme:Theme)=>{
    const light=theme==='light';
    document.body.classList.toggle('light',light);
    document.documentElement.classList.remove('light-start');
    const button=document.querySelector<HTMLButtonElement>('#theme');
    button?.setAttribute('aria-pressed',String(light));
    button?.setAttribute('aria-label',light?'Switch to dark mode':'Switch to light mode');
    const label=button?.querySelector('.theme-label');
    if(label) label.textContent=light?'Dark mode':'Light mode';
  };
  const getSavedTheme=():Theme=>{
    try {
      return localStorage.getItem('theme')==='light'?'light':'dark';
    } catch(error) {
      console.error('Unable to read the saved theme preference.',error);
      return 'dark';
    }
  };
  const textSizes:TextSize[]=['small','medium','large'];
  const textSizeValues={
    small:{desktop:'clamp(1.05rem, .9vw + .85rem, 1.25rem)',mobile:'1rem'},
    medium:{desktop:'clamp(1.2rem, 1.05vw + .95rem, 1.45rem)',mobile:'1.15rem'},
    large:{desktop:'clamp(1.4rem, 1.4vw + 1rem, 1.8rem)',mobile:'1.35rem'}
  } satisfies Record<TextSize,{desktop:string;mobile:string}>;
  const isTextSize=(size:string|null|undefined):size is TextSize=>textSizes.some(option=>option===size);
  const applyTextSize=(size:TextSize)=>{
    const textSize=size;
    document.documentElement.dataset.textSize=textSize;
    const article=document.querySelector<HTMLElement>('.blog-post .body .prose');
    if(article) {
      const values=textSizeValues[textSize];
      article.style.fontSize=window.matchMedia('(max-width: 720px)').matches?values.mobile:values.desktop;
    }
    document.querySelectorAll<HTMLButtonElement>('[data-text-size]').forEach(button=>{
      button.setAttribute('aria-pressed',String(button.dataset.textSize===textSize));
    });
  };
  const getSavedTextSize=():TextSize=>{
    try {
      const savedSize=localStorage.getItem('text-size');
      return isTextSize(savedSize)?savedSize:'medium';
    } catch(error) {
      console.error('Unable to read the saved text size.',error);
      return 'medium';
    }
  };
  const boundButtons=new WeakSet<HTMLButtonElement>();
  const bindControls=()=>{
    const themeButton=document.querySelector<HTMLButtonElement>('#theme');
    if(themeButton&&!boundButtons.has(themeButton)) {
      boundButtons.add(themeButton);
      themeButton.addEventListener('click',()=>{
        const theme:Theme=document.body.classList.contains('light')?'dark':'light';
        applyTheme(theme);
        try {
          localStorage.setItem('theme',theme);
        } catch(error) {
          console.error('Unable to save the theme preference.',error);
        }
      });
    }

    document.querySelectorAll<HTMLButtonElement>('[data-text-size]').forEach(button=>{
      if(boundButtons.has(button)) return;
      boundButtons.add(button);
      button.addEventListener('click',()=>{
        const size=button.dataset.textSize;
        if(!isTextSize(size)) return;
        applyTextSize(size);
        try {
          localStorage.setItem('text-size',size);
        } catch(error) {
          console.error('Unable to save the text size.',error);
        }
      });
    });
  };
  applyTheme(getSavedTheme());
  applyTextSize(getSavedTextSize());
  bindControls();
  document.addEventListener('astro:page-load',()=>{
    applyTheme(getSavedTheme());
    applyTextSize(getSavedTextSize());
    bindControls();
  });
  window.addEventListener('resize',()=>{
    const size=document.documentElement.dataset.textSize;
    applyTextSize(isTextSize(size)?size:'medium');
  });
</script>
<style>
.header{border-bottom:1px solid var(--ink)}.top{height:88px;display:flex;align-items:center;justify-content:space-between}.brand{display:inline-flex;align-items:center;flex:0 0 auto}.brand img{display:block;width:48px;height:48px;object-fit:contain}.issue{font-size:.7rem}.navwrap{display:flex;align-items:center;justify-content:space-between;gap:.75rem;border-top:1px solid var(--line);height:47px}nav{display:flex;flex:1;min-width:0;gap:2rem;font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;white-space:nowrap}nav a{flex:0 0 auto}nav a:hover{text-decoration:underline;text-underline-offset:5px}.header-controls{display:flex;align-items:center;gap:.55rem;flex:0 0 auto}.reading-settings{display:flex;align-items:center;gap:.1rem;padding:.2rem;border:1px solid var(--line);border-radius:999px;background:color-mix(in srgb,var(--paper) 84%,transparent)}.reading-mark{padding:0 .25rem 0 .4rem;color:var(--muted);font:600 .68rem Newsreader,Georgia,serif}.header-controls button{flex:0 0 auto;min-height:1.75rem;border:1px solid transparent;border-radius:999px;background:transparent;color:var(--ink);padding:.3rem .6rem;display:flex;align-items:center;justify-content:center;gap:.35rem;font:600 .72rem Manrope,system-ui,sans-serif;cursor:pointer;transition:background .18s ease,border-color .18s ease,color .18s ease}.header-controls button:hover{background:color-mix(in srgb,var(--ink) 8%,transparent)}.header-controls button[data-text-size=small]{font-size:.66rem}.header-controls button[data-text-size=medium]{font-size:.76rem}.header-controls button[data-text-size=large]{font-size:.9rem}.header-controls button[aria-pressed=true][data-text-size]{background:color-mix(in srgb,var(--lime) 24%,var(--paper));border-color:color-mix(in srgb,var(--lime) 55%,var(--line));color:var(--ink)}.header-controls #theme{border:1px solid var(--line);background:color-mix(in srgb,var(--paper) 84%,transparent)}.header-controls #theme:hover{background:var(--ink);color:var(--paper)}.header-controls button span[aria-hidden]{font-size:1rem}.theme-label{white-space:nowrap}.header-controls button:focus-visible{outline:2px solid var(--blue);outline-offset:2px}@media(max-width:720px){.issue{display:none}.top{height:70px}nav{gap:1rem;overflow-x:auto;overscroll-behavior-x:contain;scrollbar-width:none;font-size:.68rem}nav::-webkit-scrollbar{display:none}.navwrap{height:auto;min-height:52px;flex-wrap:wrap;gap:.4rem;padding-top:.45rem;padding-bottom:.45rem}nav{flex:0 0 100%;order:1}.header-controls{order:2;width:100%;justify-content:flex-end;gap:.4rem}.header-controls #theme,.header-controls .reading-settings button{padding:.35rem .55rem}.reading-settings{gap:.05rem;padding:.15rem}.reading-mark{padding:0 .25rem 0 .4rem}}@media(max-width:380px){nav{gap:.75rem;font-size:.62rem}.header-controls #theme,.header-controls .reading-settings button{min-height:2.25rem;padding:.35rem .55rem}}
</style>
